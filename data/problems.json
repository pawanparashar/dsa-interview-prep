            "note": "num = 1 — not in h, so add it. h = {1}"
          },
          {
            "idx": 1,
            "set": [
              1,
              2
            ],
            "status": "add",
            "note": "num = 2 — not in h, so add it. h = {1, 2}"
          },
          {
            "idx": 2,
            "set": [
              1,
              2,
              3
            ],
            "status": "add",
            "note": "num = 3 — not in h, so add it. h = {1, 2, 3}"
          },
          {
            "idx": 3,
            "set": [
              1,
              2,
              3
            ],
            "status": "found",
            "note": "num = 1 — already in h! Return True immediately."
          }
        ]
      }
