<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ p.title }} — One-pager</title>
<style>
  @page { size: Letter; margin: {{ (14*scale)|round(2) }}mm; }
  :root {
    --panel: #ffffff;
    --panel-2: #fafaf8;
    --border: #d8dad6;
    --fg: #1b1d22;
    --muted: #5d636f;
    --accent: #0e8f86;
    --accent-dim: #dcf1ef;
    --code-bg: #f4f6f5;
    --font-display: 'JetBrains Mono', monospace;
    --font-body: 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--panel);
    color: var(--fg);
    font-family: var(--font-body);
  }
  .wrap { width: 100%; }
  .head {
    display: block;
    border-bottom: 2px solid var(--accent);
    padding-bottom: {{ (10*scale)|round(2) }}px;
    margin-bottom: {{ (14*scale)|round(2) }}px;
  }
  .head .num { font-family: var(--font-display); color: var(--accent); font-size: {{ (14*scale)|round(2) }}px; }
  .head h1 { font-family: var(--font-display); font-size: {{ (22*scale)|round(2) }}px; margin: 0 0 {{ (6*scale)|round(2) }}px; }
  .pills { display: block; }
  .pill {
    display: inline-block;
    font-family: var(--font-mono); font-size: {{ (10*scale)|round(2) }}px; letter-spacing: 0.02em;
    padding: {{ (3*scale)|round(2) }}px {{ (8*scale)|round(2) }}px; border-radius: 999px; border: 1px solid var(--border);
    color: var(--muted); background: var(--panel-2); white-space: nowrap;
    margin: 0 {{ (6*scale)|round(2) }}px {{ (4*scale)|round(2) }}px 0;
  }
  .pill.accent { color: var(--accent); border-color: var(--accent-dim); background: var(--accent-dim); }
  .row { display: block; margin-bottom: {{ (10*scale)|round(2) }}px; page-break-inside: avoid; }
  .row::after { content: ""; display: table; clear: both; }
  .card {
    background: var(--panel); border: 1px solid var(--border); border-radius: {{ (8*scale)|round(2) }}px;
    padding: {{ (12*scale)|round(2) }}px {{ (14*scale)|round(2) }}px;
    page-break-inside: avoid;
  }
  .row .card { float: left; width: 48%; }
  .row .card + .card { float: right; }
  .card.full { clear: both; width: 100%; margin-bottom: {{ (10*scale)|round(2) }}px; }
  .card h2 {
    font-family: var(--font-mono); font-size: {{ (10.5*scale)|round(2) }}px; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--accent); margin: 0 0 {{ (8*scale)|round(2) }}px;
  }
  .card p { margin: 0 0 {{ (6*scale)|round(2) }}px; font-size: {{ (11.5*scale)|round(2) }}px; line-height: 1.4; }
  .card p:last-child { margin-bottom: 0; }
  .label { color: var(--muted); font-size: {{ (10*scale)|round(2) }}px; font-family: var(--font-mono); }
  .examples div {
    font-family: var(--font-mono); font-size: {{ (10.5*scale)|round(2) }}px; background: var(--code-bg);
    border: 1px solid var(--border); border-radius: {{ (5*scale)|round(2) }}px; padding: {{ (4*scale)|round(2) }}px {{ (8*scale)|round(2) }}px; margin-bottom: {{ (4*scale)|round(2) }}px;
  }
  .callout {
    border-left: 3px solid var(--accent); background: var(--accent-dim);
    border-radius: 0 {{ (5*scale)|round(2) }}px {{ (5*scale)|round(2) }}px 0; padding: {{ (6*scale)|round(2) }}px {{ (10*scale)|round(2) }}px; font-size: {{ (11*scale)|round(2) }}px; margin-top: {{ (5*scale)|round(2) }}px;
  }
  ol, ul { margin: 0; padding-left: {{ (16*scale)|round(2) }}px; font-size: {{ (11.5*scale)|round(2) }}px; line-height: 1.4; }
  li { margin-bottom: {{ (2*scale)|round(2) }}px; }
  pre {
    background: var(--code-bg); border: 1px solid var(--border); border-radius: {{ (6*scale)|round(2) }}px;
    padding: {{ (8*scale)|round(2) }}px {{ (10*scale)|round(2) }}px; margin: 0; white-space: pre-wrap; word-break: break-word;
  }
  code { font-family: var(--font-mono); font-size: {{ (10*scale)|round(2) }}px; line-height: 1.35; color: var(--fg); }
  .kw { color: var(--accent); font-weight: 600; }
  .complexity { display: block; margin-top: {{ (8*scale)|round(2) }}px; }
  .complexity::after { content: ""; display: table; clear: both; }
  .complexity .box {
    float: left; width: calc(50% - {{ (4*scale)|round(2) }}px); background: var(--code-bg); border: 1px solid var(--border);
    border-radius: {{ (5*scale)|round(2) }}px; padding: {{ (5*scale)|round(2) }}px {{ (8*scale)|round(2) }}px; text-align: center;
  }
  .complexity .box + .box { float: right; }
  .complexity .box .v { font-family: var(--font-mono); color: var(--accent); font-size: {{ (14*scale)|round(2) }}px; display: block; }
  .complexity .box .k { font-size: {{ (8.5*scale)|round(2) }}px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .quote { font-size: {{ (10.5*scale)|round(2) }}px; font-style: italic; color: var(--muted); border-left: 3px solid var(--border); padding-left: {{ (8*scale)|round(2) }}px; margin-top: {{ (6*scale)|round(2) }}px; }
  .edge-list { display: block; list-style: none; padding: 0; margin: 0; }
  .edge-list::after { content: ""; display: table; clear: both; }
  .edge-list li { font-size: {{ (10.5*scale)|round(2) }}px; width: calc(50% - {{ (8*scale)|round(2) }}px); float: left; margin-bottom: {{ (4*scale)|round(2) }}px; }
  .edge-list li:nth-child(even) { float: right; }
  .edge-list li::before { content: "\2023"; color: var(--accent); margin-right: {{ (4*scale)|round(2) }}px; }
</style>
</head>
<body>
<div class="wrap">
  <div class="head">
    <span class="num">#{{ p.number }}</span>
    <h1>{{ p.title }}</h1>
    <div class="pills">
      <span class="pill accent">{{ p.category }}</span>
      <span class="pill">LeetCode {{ p.leetcode_number }}</span>
      <span class="pill">NeetCode "{{ p.neetcode_name }}"</span>
    </div>
  </div>

  <div class="row">
    <div class="card">
      <h2>Problem</h2>
      <p>{{ p.problem_statement | safe }}</p>
      <div class="examples">
        {% for ex in p.examples %}
        <div>{{ ex.input }} → {{ ex.output }}</div>
        {% endfor %}
      </div>
    </div>

    <div class="card">
      <h2>Core idea</h2>
      <p><span class="label">Goal</span><br>{{ p.core_idea.goal }}</p>
      <p><span class="label">Key insight</span><br>{{ p.core_idea.key_insight }}</p>
      <div class="callout">Trigger: {{ p.core_idea.trigger_phrase | safe }}</div>
    </div>
  </div>

  <div class="row">
    <div class="card">
      <h2>Optimal solution</h2>
      <p><span class="label">Data structure</span> — {{ p.optimal_solution.data_structure | safe }}</p>
      <ol>
        {% for step in p.optimal_solution.steps %}
        <li>{{ step | safe }}</li>
        {% endfor %}
      </ol>
      <div class="complexity">
        <div class="box"><span class="v">{{ p.optimal_solution.time_complexity }}</span><span class="k">Time</span></div>
        <div class="box"><span class="v">{{ p.optimal_solution.space_complexity }}</span><span class="k">Space</span></div>
      </div>
    </div>

    <div class="card">
      <h2>Code</h2>
      <pre><code>{{ p.code_html | safe }}</code></pre>
    </div>
  </div>

  <div class="card full">
    <h2>Tips to remember</h2>
    <p><span class="label">Mental shortcut</span> — {{ p.mental_shortcut }}</p>
    <p><span class="label">Common / related</span> — {{ p.related_problems | join(", ") }}</p>
    <div class="quote">"{{ p.interview_talking_point }}"</div>
  </div>

  <div class="card full">
    <h2>Edge cases</h2>
    <ul class="edge-list">
      {% for ec in p.edge_cases %}
      <li>{{ ec }}</li>
      {% endfor %}
    </ul>
  </div>
</div>
</body>
</html>
