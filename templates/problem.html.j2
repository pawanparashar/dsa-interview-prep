<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ p.title }} — {{ site.title }}</title>
<meta name="description" content="{{ p.title }} ({{ p.category }}) — pattern, walkthrough, video, and printable one-pager.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../../assets/css/site.css">
</head>
<body>
  <header class="topbar">
    <div class="container row">
      <div>
        <a class="brand" href="../../index.html">{{ site.title.split(" ")[0] }} <span class="dot">{{ site.title.split(" ")[1] }}</span></a>
        <div class="tagline">{{ site.tagline }}</div>
      </div>
      <nav>
        <a href="{{ site.github }}">GitHub ↗</a>
      </nav>
    </div>
  </header>

  <div class="container">
    <div class="p-head">
      <a class="crumbs" href="../../index.html">← All 75</a>
      <h1>#{{ p.number }} — {{ p.title }}</h1>
      <div class="pills">
        <span class="pill accent">{{ p.category }}</span>
        <span class="pill">LeetCode {{ p.leetcode_number }}</span>
        <span class="pill">NeetCode "{{ p.neetcode_name }}"</span>
        <span class="badge {{ p.difficulty }}">{{ p.difficulty }}</span>
      </div>
      <div class="p-actions">
        <a class="linkbtn" href="{{ p.slug }}-onepager.pdf">Download one-pager (PDF) ↓</a>
      </div>
    </div>

    <div class="section">
      <h2>Problem</h2>
      <p>{{ p.problem_statement | safe }}</p>
      <div class="examples">
        {% for ex in p.examples %}
        <div>{{ ex.input }} → {{ ex.output }}</div>
        {% endfor %}
      </div>
    </div>

    <div class="section">
      <h2>Watch the walkthrough</h2>
      <div class="video-frame">
        <iframe src="https://www.youtube.com/embed/{{ p.youtube_id }}" title="{{ p.title }} solution walkthrough" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
      </div>
    </div>

    <div class="section">
      <h2>Core idea</h2>
      <p><strong>Goal</strong><br>{{ p.core_idea.goal }}</p>
      <p><strong>Key insight</strong><br>{{ p.core_idea.key_insight }}</p>
      <div class="callout">Trigger phrase: {{ p.core_idea.trigger_phrase | safe }}</div>
    </div>

    {% if p.trace %}
    <div class="section">
      <h2>Step through it</h2>
      <p class="muted">Walk the algorithm one step at a time — forward, back, or press play.</p>
      <div class="viz" id="viz" data-trace="{{ p.trace_json }}">
        <div class="viz-body" id="vizBody"></div>
        <div class="viz-note" id="vizNote"></div>
        <div class="viz-controls">
          <button class="viz-btn" id="vizPrev" aria-label="Previous step">&larr; Prev</button>
          <button class="viz-btn accent" id="vizPlay" aria-label="Play">&#9654; Play</button>
          <button class="viz-btn" id="vizNext" aria-label="Next step">Next &rarr;</button>
          <span class="viz-step-count" id="vizCount"></span>
        </div>
        <div class="viz-progress"><div class="viz-progress-fill" id="vizProgressFill"></div></div>
      </div>
    </div>
    {% endif %}

    <div class="section">
      <h2>Walkthrough</h2>
      {% for para in p.walkthrough %}
      <p>{{ para | safe }}</p>
      {% endfor %}
    </div>

    <div class="section">
      <h2>Optimal solution</h2>
      <p><strong>Data structure:</strong> {{ p.optimal_solution.data_structure | safe }}</p>
      <ol class="steps">
        {% for step in p.optimal_solution.steps %}
        <li>{{ step | safe }}</li>
        {% endfor %}
      </ol>
      <div class="complexity">
        <div class="box"><span class="v">{{ p.optimal_solution.time_complexity }}</span><span class="k">Time</span></div>
        <div class="box"><span class="v">{{ p.optimal_solution.space_complexity }}</span><span class="k">Space</span></div>
      </div>
    </div>

    <div class="section">
      <h2>Code</h2>
      <pre><code>{{ p.code_html | safe }}</code></pre>
    </div>

    {% if p.alternative_solutions %}
    <div class="section">
      <h2>Other ways to solve it</h2>
      {% for alt in p.alternative_solutions %}
      <div class="alt-solution">
        <h3>{{ alt.name }}</h3>
        {% if alt.note %}<p class="muted">{{ alt.note | safe }}</p>{% endif %}
        <pre><code>{{ alt.code_html | safe }}</code></pre>
        <div class="complexity">
          <div class="box"><span class="v">{{ alt.time_complexity }}</span><span class="k">Time</span></div>
          <div class="box"><span class="v">{{ alt.space_complexity }}</span><span class="k">Space</span></div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="section">
      <h2>Tips to remember this pattern</h2>
      <p><strong>Mental shortcut</strong> — {{ p.mental_shortcut }}</p>
      <p><strong>Common / related problems</strong></p>
      <ul class="plain">
        {% for rp in p.related_problems %}
        <li>{{ rp }}</li>
        {% endfor %}
      </ul>
      <div class="quote">"{{ p.interview_talking_point }}"</div>
    </div>

    <div class="section">
      <h2>Edge cases to consider</h2>
      <ul class="edge-list">
        {% for ec in p.edge_cases %}
        <li>{{ ec }}</li>
        {% endfor %}
      </ul>
    </div>

    <div class="section">
      <h2>Day-of-interview revision</h2>
      <p class="muted">Short on time? Skim the trigger phrase, the steps above, and keep this PDF open as a fallback.</p>
      <div class="p-actions">
        <a class="linkbtn" href="{{ p.slug }}-onepager.pdf">Download one-pager (PDF) ↓</a>
        <a class="linkbtn ghost" href="../../index.html">Back to all 75 →</a>
      </div>
    </div>
  </div>

  <footer>
    <div class="container">Built by {{ site.author }} · generated from <a href="{{ site.github }}">dsa-interview-prep</a></div>
  </footer>

  {% if p.trace %}
  <script>
  (function () {
    var root = document.getElementById('viz');
    if (!root) return;
    var trace = JSON.parse(root.dataset.trace);
    var mode = trace.mode || 'array-set';
    var frames = trace.frames;
    var cur = 0;
    var playing = false;
    var timer = null;

    var bodyEl = document.getElementById('vizBody');
    var noteEl = document.getElementById('vizNote');
    var countEl = document.getElementById('vizCount');
    var fillEl = document.getElementById('vizProgressFill');
    var prevBtn = document.getElementById('vizPrev');
    var nextBtn = document.getElementById('vizNext');
    var playBtn = document.getElementById('vizPlay');

    function makeCells(container, chars) {
      chars.split('').forEach(function (ch) {
        var cell = document.createElement('div');
        cell.className = 'viz-cell';
        cell.textContent = ch;
        container.appendChild(cell);
      });
    }

    function renderChips(container, counts, highlightKey, mismatch) {
      container.innerHTML = '';
      var keys = Object.keys(counts);
      if (keys.length === 0) {
        var empty = document.createElement('span');
        empty.className = 'viz-set-empty';
        empty.textContent = '(empty)';
        container.appendChild(empty);
        return;
      }
      keys.forEach(function (k) {
        var chip = document.createElement('span');
        chip.className = 'viz-chip';
        if (k === highlightKey) chip.classList.add(mismatch ? 'found' : 'active');
        chip.textContent = k + ':' + counts[k];
        container.appendChild(chip);
      });
    }

    var updateFrame;

    if (mode === 'strings') {
      bodyEl.innerHTML =
        '<div class="viz-str-row"><span class="viz-str-label">s =</span><div class="viz-array" id="vizArrS"></div></div>' +
        '<div class="viz-str-row"><span class="viz-str-label">t =</span><div class="viz-array" id="vizArrT"></div></div>' +
        '<div class="viz-counts-row">' +
          '<div class="viz-counts"><div class="viz-set-label">counterS =</div><div class="viz-set" id="vizChipsS"></div></div>' +
          '<div class="viz-counts"><div class="viz-set-label">counterT =</div><div class="viz-set" id="vizChipsT"></div></div>' +
        '</div>';
      makeCells(document.getElementById('vizArrS'), trace.s);
      makeCells(document.getElementById('vizArrT'), trace.t);
      var sCells = bodyEl.querySelectorAll('#vizArrS .viz-cell');
      var tCells = bodyEl.querySelectorAll('#vizArrT .viz-cell');
      var chipsS = document.getElementById('vizChipsS');
      var chipsT = document.getElementById('vizChipsT');

      updateFrame = function (f) {
        sCells.forEach(function (cell, i) {
          cell.classList.remove('active', 'done');
          if (f.sIdx !== null && i === f.sIdx) cell.classList.add('active');
          else if (f.phase !== 'build' || (f.sIdx !== null && i < f.sIdx)) cell.classList.add('done');
        });
        tCells.forEach(function (cell, i) {
          cell.classList.remove('active', 'done');
          if (f.tIdx !== null && i === f.tIdx) cell.classList.add('active');
          else if (f.phase !== 'build' || (f.tIdx !== null && i < f.tIdx)) cell.classList.add('done');
        });
        var mismatch = f.status === 'mismatch';
        renderChips(chipsS, f.counterS, f.compareKey, mismatch);
        renderChips(chipsT, f.counterT, f.compareKey, mismatch);
      };
    } else {
      bodyEl.innerHTML =
        '<div class="viz-array" id="vizArray"></div>' +
        '<div class="viz-set-row"><span class="viz-set-label">h =</span><div class="viz-set" id="vizSet"></div></div>';
      var arrayEl = document.getElementById('vizArray');
      trace.array.forEach(function (val) {
        var cell = document.createElement('div');
        cell.className = 'viz-cell';
        cell.textContent = val;
        arrayEl.appendChild(cell);
      });
      var cells = arrayEl.querySelectorAll('.viz-cell');
      var setEl = document.getElementById('vizSet');

      updateFrame = function (f) {
        cells.forEach(function (cell, i) {
          cell.classList.remove('active', 'found', 'done');
          if (f.idx !== null && i === f.idx) {
            cell.classList.add(f.status === 'found' ? 'found' : 'active');
          } else if (f.idx !== null && i < f.idx) {
            cell.classList.add('done');
          }
        });
        setEl.innerHTML = '';
        if (f.set.length === 0) {
          var empty = document.createElement('span');
          empty.className = 'viz-set-empty';
          empty.textContent = '(empty)';
          setEl.appendChild(empty);
        } else {
          f.set.forEach(function (v) {
            var chip = document.createElement('span');
            chip.className = 'viz-chip';
            chip.textContent = v;
            setEl.appendChild(chip);
          });
        }
      };
    }

    function render() {
      var f = frames[cur];
      updateFrame(f);
      var flag = f.status === 'found' || f.status === 'mismatch';
      noteEl.textContent = f.note;
      noteEl.className = 'viz-note' + (flag ? ' found' : '');
      countEl.textContent = 'Step ' + (cur + 1) + ' / ' + frames.length;
      fillEl.style.width = (((cur + 1) / frames.length) * 100) + '%';
      prevBtn.disabled = cur === 0;
      nextBtn.disabled = cur === frames.length - 1;
      if (cur === frames.length - 1) stopPlaying();
    }

    function goTo(i) {
      cur = Math.max(0, Math.min(frames.length - 1, i));
      render();
    }

    function stopPlaying() {
      playing = false;
      playBtn.innerHTML = '&#9654; Play';
      if (timer) { clearInterval(timer); timer = null; }
    }

    function startPlaying() {
      if (cur === frames.length - 1) cur = 0;
      playing = true;
      playBtn.innerHTML = '&#10074;&#10074; Pause';
      timer = setInterval(function () {
        if (cur >= frames.length - 1) { stopPlaying(); render(); return; }
        goTo(cur + 1);
      }, 1400);
    }

    prevBtn.addEventListener('click', function () { stopPlaying(); goTo(cur - 1); });
    nextBtn.addEventListener('click', function () { stopPlaying(); goTo(cur + 1); });
    playBtn.addEventListener('click', function () {
      if (playing) { stopPlaying(); } else { startPlaying(); }
    });

    render();
  })();
  </script>
  {% endif %}
</body>
</html>
